<?xml version="1.0" encoding="utf-8"?>
<!-- Where someone travels stays on their phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="search-history.db" />
        <exclude domain="database" path="search-history.db-shm" />
        <exclude domain="database" path="search-history.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="search-history.db" />
        <exclude domain="database" path="search-history.db-shm" />
        <exclude domain="database" path="search-history.db-wal" />
    </device-transfer>
</data-extraction-rules>
